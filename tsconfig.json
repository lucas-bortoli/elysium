{
  "compilerOptions": {
    // rquickjs embeds quickjs-ng, which covers the ES2023 core language
    // and builtins. There's no browser/Node host, so no DOM/Node lib.
    "target": "ES2023",
    "lib": ["ES2023"],

    // Programs are evaluated as real ES modules (src/runtime.rs's
    // ElysiumRuntime::eval_module + CompilingLoader resolve relative
    // imports straight off disk). "preserve" is still the closest fit since
    // nothing here ever emits: the type-stripping transform
    // (src/transform/type_stripping.rs) only erases type syntax, it doesn't
    // touch import/export.
    "module": "preserve",
    "moduleDetection": "force",

    // JSX is rewritten by src/transform/jsx.rs into calls to the `h`/
    // `Fragment` factory exported from runtime/jsx.tsx (see types/jsx.d.ts
    // for the ambient `JSX` namespace this pairs with). src/runtime.rs
    // bootstraps `h`/`Fragment` as globals, so programs never need to
    // import them — there's no React runtime, so "react-jsx"'s automatic
    // `react/jsx-runtime` import isn't applicable here.
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",

    // The type-stripping transform (src/transform/type_stripping.rs) only
    // erases type syntax; it performs no type checking of its own, so this
    // config is what actually catches program errors before they run.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Only the host-provided globals declared in types/elysium.d.ts exist —
    // no ambient Node/DOM/web-worker types.
    "types": [],

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "programs/**/*.ts",
    "programs/**/*.tsx",
    "runtime/**/*.ts",
    "runtime/**/*.tsx",
    "types/**/*.d.ts"
  ]
}
