{
  "compilerOptions": {
    // rquickjs embeds quickjs-ng, which covers the ES2023 core language
    // and builtins. There's no browser/Node host, so no DOM/Node lib.
    "target": "ES2023",
    "lib": ["ES2023"],

    // Programs run as plain top-level scripts evaluated directly in a VM
    // (src/runtime.rs's ElysiumRuntime::eval), not as ES modules with a
    // loader/resolver — so there's no module graph to resolve. "preserve"
    // is the closest fit since nothing here ever emits: the type-stripping
    // transform (src/transform/type_stripping.rs) only erases type syntax,
    // it doesn't touch import/export.
    "module": "preserve",
    "moduleDetection": "force",

    // The type-stripping transform (src/transform/type_stripping.rs) only
    // erases type syntax; it performs no type checking of its own, so this
    // config is what actually catches program errors before they run.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Only the host-provided globals declared in types/elysium.d.ts exist —
    // no ambient Node/DOM/web-worker types.
    "types": [],

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["programs/**/*.ts", "types/**/*.d.ts"]
}
